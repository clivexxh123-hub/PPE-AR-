PORT=9530

# 身份与权限默认开启。生产环境禁止设置为 false。
AUTH_ENABLED=true
ALLOWED_WEB_ORIGINS=http://127.0.0.1:9531,http://localhost:9531

# 会话密钥至少 32 个随机字符，必须由部署环境注入，不得提交真实值。
IAM_SESSION_SECRET=
IAM_SESSION_HOURS=12
IAM_PASSWORD_MAX_ATTEMPTS=5
IAM_PASSWORD_LOCK_MINUTES=15

# 单租户开发默认使用 shoudun-ppe；业务归档时间默认按中国标准时间生成。
IAM_TENANT_ID=shoudun-ppe
BUSINESS_TIMEZONE=Asia/Shanghai

# 首个管理员通过 npm run bootstrap:admin 创建，不在代码或迁移中硬编码个人手机号。
IAM_BOOTSTRAP_ADMIN_NAME=
IAM_BOOTSTRAP_ADMIN_PHONE=
IAM_BOOTSTRAP_ADMIN_ORG_CODE=
IAM_BOOTSTRAP_ADMIN_PASSWORD=

# Python AI 服务。前端只访问本 Node 服务，由后端转发任务、状态和结果文件。
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=15000

AI_MODEL_PROFILE_ID=ppe-marketing-v1
AI_WORKFLOW_VERSION=v1

# 当前演示部署将生成演示、模特和场景接口及图片转发到本服务。
# 内置种子资源不要求数据库连接；若改为完整独立部署，请填写以下配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 可选：商品同步接口配置。演示部署无需填写。
JACKYUN_APPKEY=
JACKYUN_SECRET=
JACKYUN_CHANNEL=
JACKYUN_API_URL=
JACKYUN_METHOD=
JACKYUN_VERSION=
