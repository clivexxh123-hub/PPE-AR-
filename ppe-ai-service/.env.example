# AI 引擎：mock 表示本地占位生成；comfyui 表示调用本机 ComfyUI。
AI_ENGINE=mock

# 本机 ComfyUI 服务地址。ComfyUI Desktop 启动后通常是这个地址。
# AI_ENGINE=comfyui
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=app/templates/comfyui/text_to_image_workflow.json
# COMFYUI_IMAGE_TO_IMAGE_WORKFLOW_PATH=app/templates/comfyui/image_to_image_workflow.json
# COMFYUI_HUMAN_WEARING_WORKFLOW_PATH=app/templates/comfyui/human_wearing_inpaint_workflow.json
# COMFYUI_HUMAN_WEARING_BLEND_DENOISE=0.65

# 正式任务中心联调：开启后 /ai/tasks 要求完整冻结协议字段。
# AI_TASK_REQUIRE_FORMAL_CONTRACT=false

# 任务中心提供的 callback HMAC 密钥；不要提交真实值。
# PPE_CALLBACK_HMAC_SECRET=

# 如果自动识别不准，可以手动指定 ComfyUI API 工作流里的节点 ID。
# COMFYUI_POSITIVE_NODE_ID=6
# COMFYUI_NEGATIVE_NODE_ID=7
# COMFYUI_LATENT_NODE_ID=5
# COMFYUI_IMAGE_NODE_ID=10
# COMFYUI_MASK_NODE_ID=12
# COMFYUI_SAVE_NODE_ID=9

# 负向 Prompt，用于减少低质量、变形和错误文字。
# COMFYUI_NEGATIVE_PROMPT=低清晰度、模糊、畸形、文字错误、水印、Logo 变形、产品结构错误
