{
  "notes": {
    "replace_before_use": [
      "将 example.com URL 替换为业务端可访问的真实 HTTPS URL。",
      "将 uploadUrl 替换为业务端生成的 OSS PUT 预签名 URL。",
      "assetKey、jobId、tenantId 和 traceId 应由业务端按实际任务生成。"
    ]
  },
  "examples": {
    "product_to_image_generation": {
      "jobId": "gen_example_001",
      "type": "image_generation",
      "tenantId": "tenant_example",
      "traceId": "trace_example_001",
      "attempt": 0,
      "modelProfileId": "sd15_ppe_product_v1",
      "workflowVersion": "ppe-marketing-v1.0",
      "inputAssets": [
        {
          "assetId": "asset_product_example_001",
          "role": "product_reference",
          "version": 1,
          "url": "https://assets.example/products/helmet.png?signature=placeholder",
          "expiresAt": "2026-08-30T18:00:00.000Z"
        }
      ],
      "parameters": {
        "product_image": {
          "url": "https://assets.example/products/helmet.png?signature=placeholder"
        },
        "product_name": "工业安全帽",
        "product_category": "个人防护/头部防护/安全帽",
        "scene": "现代工厂车间",
        "style": "真实商业产品图风格，单个产品，干净背景",
        "size": "512x512",
        "output_format": "png",
        "prompt_overrides": {
          "goal": "展示产品专业、安全、可靠"
        }
      },
      "callback": "https://example.com/internal/v1/jobs/gen_example_001/events",
      "output": {
        "assetKey": "results/tenant_example/gen_example_001/attempt-0/result.png",
        "uploadUrl": "https://example.com/oss/presigned-put-url",
        "method": "PUT",
        "requiredHeaders": {
          "content-type": "image/png"
        },
        "expiresAt": "2026-08-10T18:00:00.000Z"
      }
    },
